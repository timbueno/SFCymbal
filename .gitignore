# macOS and Xcode personal state
.DS_Store
xcuserdata/
*.xcuserstate

# Build products
.build/
DerivedData/
build/
*.xcarchive
*.xcresult
*.app
*.dmg
__pycache__/

# Local signing and credentials
.env
.env.*
!.env.example
*.p12
*.p8
*.mobileprovision
*.provisionprofile
Configuration/Local.xcconfig

# Private signing exports (public keys use an explicit .pub.pem suffix)
*.pfx
*.key
*.pem
!*.pub.pem
sparkle-private-key*

# Local release artifacts, including RELEASE_ROOT outside build/
SF-Cymbal-[0-9]*/
SF-Cymbal-*.zip
SF-Cymbal-*.zip.sha256
notarization*.zip
*-release.log
*-tests.log

# Plural app name
SF-Cymbals-[0-9]*/
SF-Cymbals-*.zip
SF-Cymbals-*.zip.sha256
